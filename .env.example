# Copy this file to .env and replace every required placeholder.
# Never commit .env or place real tokens in fixtures, logs, URLs, or evidence.

STAKEHOLDER_AI_ENVIRONMENT=development
STAKEHOLDER_AI_LOG_LEVEL=INFO

# Gemini is the only permitted model provider.
GOOGLE_API_KEY=
STAKEHOLDER_AI_GEMINI_PRIMARY_CHAT_MODEL=
STAKEHOLDER_AI_GEMINI_FALLBACK_CHAT_MODEL=
STAKEHOLDER_AI_GEMINI_VISION_MODEL=
STAKEHOLDER_AI_GEMINI_EMBEDDING_MODEL=
STAKEHOLDER_AI_GEMINI_EMBEDDING_DIMENSION=768

# Use high-entropy local values. The application stores only derived hashes.
STAKEHOLDER_AI_PM_BOOTSTRAP_TOKEN=
STAKEHOLDER_AI_TOKEN_PEPPER=
STAKEHOLDER_AI_INVITATION_TTL_MINUTES=1440
STAKEHOLDER_AI_STAKEHOLDER_SESSION_TTL_MINUTES=480
STAKEHOLDER_AI_PM_SESSION_TTL_MINUTES=720

# Exact same-origin browser boundary. HTTP is accepted only for loopback development.
STAKEHOLDER_AI_BROWSER_ORIGIN=http://127.0.0.1:2024

# Local persistence. All paths must resolve beneath the project data root.
STAKEHOLDER_AI_DATA_ROOT=./data
STAKEHOLDER_AI_DOMAIN_DATABASE=./data/domain.sqlite3
STAKEHOLDER_AI_CHECKPOINT_DATABASE=./data/checkpoints.sqlite3
STAKEHOLDER_AI_ORIGINALS_ROOT=./data/originals
STAKEHOLDER_AI_DERIVED_ROOT=./data/derived
STAKEHOLDER_AI_AGENT_ARTIFACTS_ROOT=./data/agent-artifacts
STAKEHOLDER_AI_AUDIT_ROOT=./data/audit

# Local Qdrant service from docker-compose.yml.
STAKEHOLDER_AI_QDRANT_URL=http://127.0.0.1:6333
STAKEHOLDER_AI_QDRANT_COLLECTION=stakeholder_intelligence
STAKEHOLDER_AI_SPARSE_MODEL=Qdrant/BM25
STAKEHOLDER_AI_RERANKER_MODEL=BAAI/bge-reranker-base

# Bounded execution defaults. Changes require boundary tests.
STAKEHOLDER_AI_MAX_UPLOAD_BYTES=52428800
STAKEHOLDER_AI_MAX_RESEARCH_TOPICS=5
STAKEHOLDER_AI_MAX_PARALLEL_RESEARCHERS=3
STAKEHOLDER_AI_MAX_RETRIEVAL_CANDIDATES_PER_CHANNEL=30
STAKEHOLDER_AI_MAX_RERANK_CANDIDATES=30
STAKEHOLDER_AI_MODEL_RUN_CALL_LIMIT=40
STAKEHOLDER_AI_MODEL_THREAD_CALL_LIMIT=120
STAKEHOLDER_AI_TOOL_RUN_CALL_LIMIT=80
STAKEHOLDER_AI_TOOL_THREAD_CALL_LIMIT=240
STAKEHOLDER_AI_RETRIEVAL_CALLS_PER_RESEARCHER_LIMIT=3
STAKEHOLDER_AI_PROVIDER_TIMEOUT_SECONDS=120
# Provider/project RPM quota. The effective application limit is LIMIT minus HEADROOM.
# Free-tier example: 15 - 1 = 14 RPM. Paid-tier example: 100 - 0 = 100 RPM.
STAKEHOLDER_AI_GEMINI_REQUESTS_PER_MINUTE_LIMIT=15
STAKEHOLDER_AI_GEMINI_REQUESTS_PER_MINUTE_HEADROOM=1
STAKEHOLDER_AI_GEMINI_RATE_LIMIT_WAIT_TIMEOUT_SECONDS=180
STAKEHOLDER_AI_INSIGHT_RUN_TIMEOUT_SECONDS=900
# Zero means no extra retries; the adapter receives one initial SDK attempt.
STAKEHOLDER_AI_PROVIDER_SDK_RETRIES=0
STAKEHOLDER_AI_SUMMARY_TRIGGER_TOKENS=12000
STAKEHOLDER_AI_SUMMARY_KEEP_MESSAGES=20

# Development-only synthetic tracing. Keep disabled for real stakeholder data.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=stakeholder-intelligence-agent-synthetic
